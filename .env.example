NODE_ENV=development
GATEWAY_PORT=3000
PAYMENTS_PORT=3001
PAYMENTS_SERVICE_URL=http://localhost:3001
# Ejecuta npm run env:init; genera valores locales sin distribuir credenciales.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://arveluna:REEMPLAZAR_CON_MYSQL_PASSWORD@localhost:3306/arveluna_payments
# Predeterminado de demo. Alias PAYMENT_PROVIDER tiene precedencia si se define.
BLOCKCHAIN_PROVIDER=simulated
# PAYMENT_PROVIDER=trongrid
TRON_NETWORK=mainnet
# Debe corresponder a TRON_NETWORK: mainnet=api.trongrid.io,
# shasta=api.shasta.trongrid.io, nile=nile.trongrid.io (solo HTTPS oficial).
TRONGRID_BASE_URL=https://api.trongrid.io
# Opcional según límites del proveedor. Solo en .env; nunca en el frontend/logs.
TRONGRID_API_KEY=
# Contrato público de referencia mainnet. Cambiar en testnet; no es una billetera.
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_DECIMALS=6
MERCHANT_WALLET_ADDRESS=TJRabPrwbZy45sbavfcjinPJC18kjpRTv8
PAYMENT_EXPIRATION_MINUTES=30
# Alias opcionales: TRC20_TOKEN_CONTRACT y TRON_MIN_CONFIRMATIONS tienen precedencia.
# TRC20_TOKEN_CONTRACT=
# TRON_MIN_CONFIRMATIONS=
MIN_CONFIRMATIONS=1
FRONTEND_ORIGIN=http://localhost:5173
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RETRIES=2

# Perfiles independientes. npm run full:env crea .env.full-app o .env.full-test.
# Estas variables solo se utilizan con ARVELUNA_FULL_APP=true.
ARVELUNA_FULL_APP=false
SESSION_SECURE=false
IDENTITY_PORT=3011
MERCHANT_PORT=3012
INVENTORY_PORT=3013
SALES_PORT=3014
CASH_PORT=3015
IMPORTS_PORT=3017
ANALYTICS_PORT=3018
# Opcionales en .env.full-app. El aprovisionador requiere estos cuatro valores
# definidos en el perfil privado, con una contraseña propia de 12+ caracteres.
BOOTSTRAP_MERCHANT_ID=
BOOTSTRAP_MERCHANT_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Contrato público ARVE preparado para la red TRON seleccionada.
ARVE_CONTRACT_ADDRESS=
ARVE_TRON_NETWORK=nile
ARVE_PAYMENT_PROVIDER=simulated
ARVE_TRONGRID_BASE_URL=
ARVE_TRONGRID_API_KEY=
ARVE_MIN_CONFIRMATIONS=1
# Generado por full:env en el perfil privado, junto con DATABASE_URL de Payments.
FULL_MYSQL_PORT=33376
FULL_BROKER_PORT=35772
FULL_BROKER_UI_PORT=35773
FULL_BROKER_PASSWORD=
