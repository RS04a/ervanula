{
  "name": "@arveluna/backend",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"tsx watch apps/payments-service/src/main.ts\" \"tsx watch apps/api-gateway/src/main.ts\"",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "node --import tsx --test test/e2e/*.test.ts",
    "db:generate": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --import tsx --env-file=../.env prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0"
  }
}
