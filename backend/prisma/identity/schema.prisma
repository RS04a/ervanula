generator client {
  provider = "prisma-client-js"
  output = "../../../node_modules/@arveluna/identity-db"
}
datasource db {
  provider = "mysql"
  url = env("IDENTITY_DATABASE_URL")
}
enum Role {
  ADMIN
  CASHIER
}
model User {
  id String @id @default(uuid())
  merchantId String
  email String @unique
  displayName String
  passwordHash String
  role Role
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  @@index([merchantId, id])
}
model Session {
  tokenDigest String @id @db.Char(64)
  userId String
  user User @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId, expiresAt])
}
